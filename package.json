        "@tailwindcss/vite": "^4",
        "buffer": "^6.0.3",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cuelume": "^0.2.2",
        "fflate": "^0.8.3",
        "isbot": "^5",
        "isomorphic-git": "^1.41.7",
        "lucide-react": "^1.33.0",
        "marked": "^18.0.10",
        "motion": "^13.1.1",
        "ogl": "^1.0.11",
        "prettier-plugin-tailwindcss": "^0.8.1",
