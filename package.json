{
    "name": "corpora-web",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "dev": "dotenvx run -- react-router dev",
        "dev:local": "dotenvx run -f .env.local -f .env -- react-router dev --open",
