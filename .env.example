# Copy to .env and fill in. Locally, .env is committed *encrypted* by dotenvx
# (the private key lives in .env.keys, which is never committed).
#
# NAMING RULE — this app is a client-only SPA (ssr: false):
#   VITE_*  is inlined into public JavaScript at build time. Anyone can read it.
#           Only use it for values that are safe to publish.
#   no prefix  stays out of the bundle entirely — local tooling and CLIs only.
#
# Never give a secret a VITE_ prefix, and never set one as a VITE_ variable in
# Vercel: there is no server here to hold it.

DOTENV_PUBLIC_KEY="03359d62a14ab1538f99dbf23a70775fb623eda7fb2edff09f8203ed23384a2e45"

# ── Browser-exposed (the only vars the app reads; set these in Vercel too) ──
# Publishable/anon key is browser-safe — access is governed by Supabase RLS.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional: overrides the hard-coded superadmin fallback in app/lib/projects.ts
VITE_SUPERADMIN_EMAIL=
# corpora-py conversion service (defaults to https://api.exegia.co when unset).
# See specs/004-connect-with-py/quickstart.md; point at http://127.0.0.1:8000
# to develop against a local backend.
VITE_CORPORA_API_URL=

# ── Local tooling only — must NOT be VITE_ prefixed (never bundled) ──

# Supabase: secret key, project ref, Postgres, storage
SUPABASE_SECRET_KEY=
PROJECT_REF=
SUPABASE_DB_PASSWORD=
SUPABASE_DB_USER=
SUPABASE_STORAGE_ACCESS_KEY=
SUPABASE_STORAGE_SECRET_KEY=

# AI key for local Supabase development
OPENAI_KEY=

# Apple
DEVELOPMENT_TEAM=
APPLE_TEAM_ID=

# GitHub
GITHUB_ACCESS_TOKEN=
