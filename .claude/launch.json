{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "corpora-web",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "bun run dev --port \"${PORT:-5173}\""],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "corpora-web-local",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "bunx dotenvx run -f .env.local -f .env -- react-router dev --port \"${PORT:-5174}\""
      ],
      "port": 5174,
      "autoPort": true
    },
    {
      "name": "corpora-web-prod",
      "runtimeExecutable": "bunx",
      "runtimeArgs": ["--bun", "serve", "-s", "build/client", "-l", "4173"],
      "port": 4173
    }
  ]
}
